# Supabase Postgres session pooler (5432). The username includes the tenant ID.
# Runtime user: CRUD in the private application schema, no schema/admin privileges.
DOCUMENT_DATABASE_URL="postgresql://travelbuddy_app.YOUR_TENANT_ID:YOUR_PASSWORD@127.0.0.1:5432/postgres?schema=travelbuddy_backend"
# Separate schema owner used only by pnpm db:documents:deploy.
DOCUMENT_MIGRATION_DATABASE_URL="postgresql://travelbuddy_migrator.YOUR_TENANT_ID:YOUR_PASSWORD@127.0.0.1:5432/postgres?schema=travelbuddy_backend"

SUPABASE_URL="http://localhost:8000"
SUPABASE_PUBLISHABLE_KEY=""
# Server-only key used for private buddy media storage and local test accounts.
# Never expose this or the database credentials in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=""
# Optional dedicated storage secret; falls back to SUPABASE_SECRET_KEY.
SUPABASE_STORAGE_SECRET_KEY=""
# ffprobe must be installed on the app server (included in the Docker image).
FFPROBE_PATH="ffprobe"
AUTH_APP_URL="http://localhost:3000"

TEST_ACCOUNTS_ENABLED="false"
TEST_ACCOUNT_DATABASE_HOST="127.0.0.1"
# Google/Facebook/Apple credentials live in the Supabase server .env, not this app.
