{
  "name": "travelbuddy",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "media:serve": "tsx services/profile-media/server.ts",
    "payments:serve": "tsx services/payments/server.ts",
    "build": "tsc -b && vite build && tsx scripts/build-destination-pages.ts",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "db:types": "node scripts/database.mjs types",
    "db:migrate": "node scripts/database.mjs migrate",
    "test:db": "node scripts/database.mjs test",
    "format": "prettier --write src scripts services vite.config.ts eslint.config.js README.md docs",
    "format:check": "prettier --check src scripts services vite.config.ts eslint.config.js README.md docs",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "seed:nearby": "tsx scripts/seed-nearby-demo.ts",
    "test:nearby:http": "tsx scripts/test-nearby-http.ts",
    "test:media:http": "tsx scripts/test-media-http.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@shadcn/react": "0.3.1",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "^4.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.57.0",
    "motion": "^14.6.0",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "shadcn": "4.21.5",
    "sharp": "0.35.5",
    "swapy": "^1.0.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.46",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
