generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/documents"
}

datasource db {
  provider = "postgresql"
  url      = env("DOCUMENT_DATABASE_URL")
}

// JSON references are validated by the backend; there are no ORM relations.
model AccountDocument {
  id            String   @id @default(uuid()) @db.Uuid
  data          Json     @db.JsonB
  schemaVersion Int      @default(1) @map("schema_version")
  revision      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("accounts")
}

model AuthIdentityDocument {
  id            String   @id @default(uuid()) @db.Uuid
  data          Json     @db.JsonB
  schemaVersion Int      @default(1) @map("schema_version")
  revision      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("auth_identities")
}

model SessionDocument {
  id            String   @id @default(uuid()) @db.Uuid
  data          Json     @db.JsonB
  schemaVersion Int      @default(1) @map("schema_version")
  revision      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sessions")
}
