generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/documents"
}

datasource db {
  provider = "postgresql"
  url      = env("DOCUMENT_DATABASE_URL")
}

// JSON references are validated by the backend; there are no ORM relations.
model AccountDocument {
  id            String   @id @default(uuid()) @db.Uuid
  data          Json     @db.JsonB
  schemaVersion Int      @default(1) @map("schema_version")
  revision      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversationsAsFirstUser Conversation[] @relation("ConversationFirstUser")
  conversationsAsSecondUser Conversation[] @relation("ConversationSecondUser")
  sentMessages Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  travelRequests TravelRequest[]

  @@map("accounts")
}

model Conversation {
  id                String   @id @default(uuid()) @db.Uuid
  participantOneId  String   @map("participant_one_id") @db.Uuid
  participantTwoId  String   @map("participant_two_id") @db.Uuid
  contextKey        String   @default("direct") @map("context_key") @db.VarChar(36)
  requestId         String?  @map("request_id") @db.Uuid
  request           TravelRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  participantOne    AccountDocument @relation("ConversationFirstUser", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo    AccountDocument @relation("ConversationSecondUser", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@unique([participantOneId, participantTwoId, contextKey])
  @@index([requestId])
  @@index([participantOneId, updatedAt])
  @@index([participantTwoId, updatedAt])
  @@map("conversations")
}

model TravelRequest {
  id          String @id @default(uuid()) @db.Uuid
  travelerId  String @map("traveler_id") @db.Uuid
  title       String @db.VarChar(120)
  destination String @db.VarChar(120)
  details     String @db.VarChar(2000)
  pickupLocation String? @map("pickup_location") @db.VarChar(200)
  latitude    Float?
  longitude   Float?
  closed      Boolean @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  traveler    AccountDocument @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([travelerId, createdAt, id])
  @@index([closed, createdAt, id])
  @@map("travel_requests")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  recipientId    String       @map("recipient_id") @db.Uuid
  body           String       @db.VarChar(1000)
  package        Json?        @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         AccountDocument @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      AccountDocument @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@map("messages")
}

model AuthIdentityDocument {
  id            String   @id @default(uuid()) @db.Uuid
  data          Json     @db.JsonB
  schemaVersion Int      @default(1) @map("schema_version")
  revision      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("auth_identities")
}

model SessionDocument {
  id            String   @id @default(uuid()) @db.Uuid
  data          Json     @db.JsonB
  schemaVersion Int      @default(1) @map("schema_version")
  revision      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sessions")
}
