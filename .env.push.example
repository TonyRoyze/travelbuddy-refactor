# Server only. Copy to .env.push.local for local development, or inject into the container.
# Reuse the same Supabase instance as the app. .env.media.local is also loaded locally.
SUPABASE_URL=https://supabase.shalinda.com
SUPABASE_SECRET_KEY=
APNS_TEAM_ID=3U4384584Z
APNS_KEY_ID=
APNS_ENVIRONMENT=production
APNS_TOPIC=com.travelbuddy.app
# Mount the Apple APNs .p8 key as a read-only secret file outside the repository.
APNS_PRIVATE_KEY_PATH=/run/secrets/apns-key.p8
# Alternatively inject APNS_PRIVATE_KEY as a secret (PEM, with real or escaped newlines).
# Debug iPhone builds register sandbox tokens; Release/TestFlight builds use production.
