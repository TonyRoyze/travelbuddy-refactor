# Copy to .env.verification.local. Existing settings from .env.media.local are
# loaded first. Process environment variables override both files.
# Keep this configuration on the server. Never ship provider keys to clients.

# Supabase project settings (inherited from .env.media.local unless set here).
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# HTTP listener. Include the public application origin in production.
VERIFICATION_HOST=127.0.0.1
VERIFICATION_PORT=5176
VERIFICATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# shadow = all manual; assisted = green is manual; auto = green is approved.
VERIFICATION_MODE=auto
# Hybrid is reserved for a managed KYC adapter and routes to manual review.
VERIFICATION_PROVIDER_MODE=option_a_inhouse
VERIFICATION_WORKER_ENABLED=true
VERIFICATION_POLL_INTERVAL_MS=5000
VERIFICATION_MAX_ATTEMPTS=3

# A stable, randomly generated server secret. All workers must use the same
# value. When omitted, NIC and driving licence credential hashing is skipped.
VERIFICATION_HMAC_PEPPER=

# Azure Face limited-access liveness and verification resource.
# Leave blank to route biometric results to manual review.
AZURE_FACE_ENDPOINT=
AZURE_FACE_KEY=

# Use an account configured for zero retention and no training on evidence.
# gemini defaults to gemini-2.5-flash. openai defaults to gpt-4o.
VISION_AI_PROVIDER=gemini
VISION_AI_MODEL=
VISION_AI_API_KEY=
# Defaults to the selected provider's HTTPS origin. Supply an origin only.
VISION_AI_BASE_URL=
# Allow an explicitly trusted custom HTTPS origin for the selected protocol.
VISION_AI_ALLOW_CUSTOM_ORIGIN=false
