# Server-only settings. Copy to .env.payments.local; never use VITE_ prefixes.
# Supabase values may also come from .env.media.local in local development.
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=your-public-key
SUPABASE_SECRET_KEY=your-server-only-service-key
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Optional merchant API credentials enable automated full/partial cancellation refunds.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYMENTS_SITE_URL=http://localhost:5173
# PayHere must be able to reach this public HTTPS origin; localhost cannot receive callbacks.
PAYMENTS_CALLBACK_URL=
PAYMENTS_HOST=127.0.0.1
PAYMENTS_PORT=5175
