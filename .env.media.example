# Server-only settings. Copy to .env.media.local. Never use VITE_ prefixes here.
# These credentials must belong to the SAME Supabase instance as .env.local.
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=your-public-key
SUPABASE_SECRET_KEY=your-server-only-service-key
MEDIA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIA_HOST=127.0.0.1
MEDIA_PORT=5174
# FFPROBE_PATH=/usr/bin/ffprobe
